{
  "name": "virtual-library",
  "description": "An immersive dark academia 3D virtual library.",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "start": "vite --host 0.0.0.0",
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "check": "npm run build",
    "deploy": "npm run build && wrangler pages deploy dist --project-name virtual-library --branch main",
    "cloudflare:whoami": "wrangler whoami",
    "cloudflare:projects": "wrangler pages project list"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.6",
    "@react-three/fiber": "^9.3.0",
    "@zip.js/zip.js": "^2.9.0",
    "cuelume": "^0.2.2",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-pageflip": "^2.0.3",
    "three": "^0.179.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.2",
    "vite": "^7.1.3",
    "wrangler": "^4.128.0"
  }
}
